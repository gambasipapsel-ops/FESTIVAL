# =====================================================================
# GAMBASI PAPUA SELATAN 2026 - konfigurasi server PHP
# Salin menjadi .env lalu isi. JANGAN commit file .env.
# =====================================================================

APP_ENV=local
APP_DEBUG=false
APP_URL=http://gambasi.test

# URL Web App Google Apps Script (Deploy > Web app > URL .../exec)
GAMBASI_API_URL=
# Harus sama persis dengan Script Property API_SECRET (min. 32 karakter)
GAMBASI_API_SECRET=

API_TIMEOUT=30
API_UPLOAD_TIMEOUT=120

# Isi IP reverse proxy (dipisah koma) hanya jika server berada di belakang proxy tepercaya
TRUSTED_PROXIES=

# auto (disarankan) = pakai public/assets/css/tailwind.css (sudah ikut di repo), CDN hanya bila file tidak ada
# cdn = paksa Tailwind Play CDN (hanya untuk development)
TAILWIND_MODE=auto

SESSION_TIMEOUT_MINUTES=30
ADMIN_USERS_FILE=storage/admin/admins.json

# ---------------------------------------------------------------------
# Informasi panitia (KOSONGKAN jika belum ditetapkan resmi).
# Halaman publik akan menampilkan "Akan diumumkan panitia".
# ---------------------------------------------------------------------
PANITIA_NAMA_KONTAK=
# WhatsApp admin/penyelenggara (tombol "Tanya Admin" di situs)
PANITIA_WHATSAPP=082345328926
PANITIA_EMAIL=gambasipapsel@gmail.com

# Media sosial resmi
SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61593233879268
SOCIAL_INSTAGRAM=https://www.instagram.com/gambasipapuaselatan
SOCIAL_TIKTOK=https://www.tiktok.com/@gambasipapuaselatan
SEKRETARIAT=
# Ketetapan panitia: pendaftaran gratis
BIAYA_PENDAFTARAN=GRATIS — tidak dipungut biaya
# Jadwal resmi (bila dikosongkan memakai default bawaan aplikasi)
PENDAFTARAN_BUKA=1 Oktober 2026
PENDAFTARAN_TUTUP=14 Oktober 2026
# Jadwal yang ditegakkan sistem (WIT). Di luar rentang ini formulir tidak bisa dikirim.
PENDAFTARAN_BUKA_ISO=2026-10-01T00:00:00+09:00
PENDAFTARAN_TUTUP_ISO=2026-10-14T23:59:59+09:00
JADWAL_PENDAFTARAN=1 – 14 Oktober 2026
BATAS_PENDAFTARAN=14 Oktober 2026
JADWAL_VERIFIKASI=
PRA_MEETING=17 Oktober 2026
TECHNICAL_MEETING=24 Oktober 2026
TEMPAT_MEETING=Aula Kodim 1707 Merauke
